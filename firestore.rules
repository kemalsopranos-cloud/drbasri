rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kimliği doğrulanmış hekim/klinik personeli.
    // Giriş: Firebase Authentication (e-posta/şifre) — bkz. src/auth.ts.
    // Eskiden giriş yalnızca istemcideki bir localStorage bayrağıydı ve şifre
    // kodda açık yazılıydı; bu yüzden aşağıdaki okuma izinleri tamamen
    // kapatılmak zorundaydı ve doktor randevularını GÖREMİYORDU.
    function isStaff() {
      return request.auth != null;
    }

    // Blog yazıları herkese açık içeriktir: okuma serbest.
    // Yazma/güncelleme/silme yalnızca giriş yapmış hekimde. (Önceden "create"
    // herkese açıktı — internetteki herkes siteye yazı ekleyebiliyordu; spam
    // içerik SEO'yu da doğrudan zedeler.)
    match /blog_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // Randevular hasta kişisel verisi (ad, telefon, e-posta, notlar) içerir.
    // - create: anonim hasta formu çalışmaya devam etsin diye açık
    // - read/update/delete: yalnızca giriş yapmış klinik personeli
    // Bildirim e-postası ayrıca /api/appointments üzerinden gider (Vercel
    // Serverless Function), yani talep tek kanala bağlı değildir.
    match /appointments/{appointmentId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }
  }
}
