{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/hakkimizda",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/iletisim",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/blog/idrar-yolu-enfeksiyonu-nedir-belirtileri-nedenleri-ve-tedavi-yntemleri",
      "destination": "/blog/idrar-yolu-enfeksiyonu-iye-belirtileri-tedavisi",
      "permanent": true
    },
    {
      "source": "/blog/prostat-kanseri-nedir-belirtileri-risk-faktrleri-ve-tedavi-yntemleri",
      "destination": "/blog/prostat-kanseri-belirtileri-tanisi-ve-tedavisi",
      "permanent": true
    },
    {
      "source": "/blog/tm-ynleriyle-snnet",
      "destination": "/blog/sunnet-ne-zaman-yapilmali-yontemleri",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog"
    },
    {
      "source": "/en/blog/:slug",
      "destination": "/en/blog"
    },
    {
      "source": "/ru/blog/:slug",
      "destination": "/ru/blog"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
